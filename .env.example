# ==================== DATABASE ====================
# PostgreSQL connection string - provide your own database URL
DATABASE_URL=postgresql://user:password@host:5432/database

# ==================== JWT CONFIGURATION ====================
# Secret key for JWT token signing - CHANGE IN PRODUCTION!
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret

# JWT algorithm
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== APPLICATION CONFIGURATION ====================
APP_NAME=Fuel4Exam
APP_VERSION=1.0.0

# Debug mode - Set to False in production
DEBUG=False

# Environment: development, staging, production
ENVIRONMENT=production

# ==================== CORS CONFIGURATION ====================
# Allow requests from every origin
ALLOWED_ORIGINS=*

# ==================== EMAIL CONFIGURATION ====================
# Email settings for future use
MAIL_FROM=noreply@fuel4exam.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==================== LOGGING ====================
LOG_LEVEL=INFO

# Seed account (required only when running seed.py)
SEED_CANDIDATE_PASSWORD=replace-with-a-seed-password
